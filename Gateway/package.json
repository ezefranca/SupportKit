{
  "name": "@supportkit/gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Portable SupportKit server core with Cloudflare and GitHub adapters",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-file .env.example --strict-vars false",
    "cf-typegen:check": "wrangler types worker-configuration.d.ts --env-file .env.example --strict-vars false --check",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:core": "vitest run --config vitest.core.config.ts",
    "check": "npm run cf-typegen:check && npm run typecheck:core && npm run typecheck && npm run lint && npm run test:core && npm test && npm run deploy:dry-run",
    "migrate:local": "wrangler d1 migrations apply supportkit-gateway --local",
    "migrate:remote": "wrangler d1 migrations apply supportkit-gateway --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20260903.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "wrangler": "4.156.0"
  }
}
