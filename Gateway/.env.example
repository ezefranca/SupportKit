# Local development only. Copy to .dev.vars or .env and replace every placeholder.
# Production values must be uploaded with `wrangler secret put`; never commit them.
GITHUB_APP_CLIENT_ID=REPLACE_WITH_GITHUB_APP_CLIENT_ID
GITHUB_APP_PRIVATE_KEY=REPLACE_WITH_PKCS8_PEM_ESCAPED
REPORT_ENCRYPTION_KEY_RING={"activeVersion":1,"keys":{"1":"REPLACE_WITH_BASE64URL_ENCODED_32_BYTE_KEY"}}
ISSUE_MARKER_KEY_RING={"activeVersion":1,"keys":{"1":"REPLACE_WITH_A_DIFFERENT_BASE64URL_ENCODED_32_BYTE_KEY"}}
